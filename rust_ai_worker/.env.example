# Rust AI Worker - Environment Configuration

# Redis connection
REDIS_URL=redis://redis:6379

# Model configuration
MODEL_PATH=/app/models/yolov8n.onnx

# Camera configuration (set per-worker instance)
CAMERA_ID=1
USER_ID=1
RTSP_URL=rtsp://media_server:8554/live/camera1

# Detection settings
CONFIDENCE_THRESHOLD=0.5
TARGET_FPS=25

# Logging (trace, debug, info, warn, error)
RUST_LOG=info
RUST_BACKTRACE=1
