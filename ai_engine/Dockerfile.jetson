# ==============================================================================
# Dockerfile Optimizado para Jetson Nano (JetPack 4.6.1)
# Habilita GPU (CUDA) para OpenCV y PyTorch
# ==============================================================================

# 1. CAMBIO CRÍTICO: Usamos la imagen base correcta para Jetson Nano actualizada
# Esto alinea los drivers de CUDA del contenedor con los de tu placa física.
ARG BASE_IMAGE=nvcr.io/nvidia/l4t-pytorch:r32.7.1-pth1.10-py3
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV SHELL /bin/bash
# Evita problemas de codificación (UnicodeDecodeError)
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

WORKDIR /jetson-inference

# 2. INSTALACIÓN DE PAQUETES DE SISTEMA (CON PARCHE DE LLAVES GPG)
# Eliminamos el repositorio de Kitware viejo que causa errores y actualizamos
RUN rm -f /etc/apt/sources.list.d/kitware* && \
    apt-get update || true && \
    apt-get install -y --no-install-recommends \
            cmake \
            nano \
            wget \
            curl \
            libglib2.0-0 \
            libsm6 \
            libxext6 \
            libxrender-dev \
            gstreamer1.0-tools \
            gstreamer1.0-plugins-good \
            gstreamer1.0-plugins-bad \
            gstreamer1.0-plugins-ugly \
            libgstreamer-plugins-base1.0-dev \
            libgstreamer-plugins-good1.0-dev \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 3. GESTIÓN DE OPENCV (PARA SOPORTE CUDA)
# La imagen l4t-pytorch YA TRAE un OpenCV básico, pero para YOLO necesitamos uno robusto.
# Opción A: Usamos el del sistema (python3-opencv) que es rápido de instalar.
RUN apt-get update && \
    apt-get install -y --no-install-recommends python3-opencv && \
    rm -rf /var/lib/apt/lists/*

# 4. INSTALACIÓN DE DEPENDENCIAS DE PYTHON (TU API)
# Actualizamos pip primero para evitar errores con paquetes modernos
RUN pip3 install --no-cache-dir --verbose --upgrade pip setuptools wheel Cython

# Copiamos tu archivo de requerimientos (asegúrate de que exista en la carpeta ./ai_engine)
COPY requirements.jetson.txt /app/requirements.txt
WORKDIR /app

# Instalamos las librerías necesarias para tu API (FastAPI, Uvicorn, etc.)
RUN pip3 install --no-cache-dir -r requirements.txt

# 5. COPIAR TU CÓDIGO FUENTE
# Copiamos todo el contenido de la carpeta actual al contenedor
COPY . /app

# 6. COMANDO DE ARRANQUE
# Lanza tu API automáticamente usando la GPU
CMD ["uvicorn", "src.inference_api:app", "--host", "0.0.0.0", "--port", "5050", "--workers", "1"]