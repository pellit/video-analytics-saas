# ==============================================================================
# Dockerfile Jetson Nano - OpenCV 4.10 + CUDA + Python 3.11
# ==============================================================================
ARG BASE_IMAGE=dustynv/jetson-inference:r32.7.1
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV SHELL /bin/bash
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8
ENV PATH=/usr/local/bin:${PATH}
ENV CUDACXX=/usr/local/cuda/bin/nvcc
ARG PYTHON_VERSION=3.11.9
ENV PYTHON_VERSION=${PYTHON_VERSION}
ENV PYTHON_BIN=python3.11
ENV PYTHONPATH=/usr/local/lib/python3.11/site-packages:/usr/local/lib/python3.11/dist-packages:/usr/local/python:/app/ai_engine/src

# 1. Instalación de Dependencias
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        nano wget curl unzip ca-certificates \
        build-essential cmake git pkg-config \
        libgtk-3-dev \
        libavcodec-dev libavformat-dev libswscale-dev \
        libtbb2 libtbb-dev libjpeg-dev libpng-dev libtiff-dev \
        libv4l-dev v4l-utils \
        libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
        libdc1394-22-dev \
        libssl-dev libffi-dev zlib1g-dev libbz2-dev \
        libreadline-dev libsqlite3-dev libncursesw5-dev \
        xz-utils tk-dev uuid-dev && \
    rm -rf /var/lib/apt/lists/*

# 2. Instalación de libcudacxx (ESTRATEGIA SEGURA)
# Clonamos en /opt/libcudacxx.
# La carpeta include contiene 'cuda' y 'nv'.
# Ruta final será: /opt/libcudacxx/include/cuda/std/tuple
RUN git clone --depth 1 https://github.com/NVIDIA/libcudacxx.git /opt/libcudacxx

# 3. Compilación de Python 3.11
WORKDIR /tmp
RUN wget https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz && \
    tar -xzf Python-${PYTHON_VERSION}.tgz && \
    cd Python-${PYTHON_VERSION} && \
    ./configure --enable-optimizations --with-ensurepip=install && \
    make -j2 && \
    make altinstall && \
    cd /tmp && rm -rf Python-${PYTHON_VERSION}* && \
    ${PYTHON_BIN} -m ensurepip && \
    ${PYTHON_BIN} -m pip install --upgrade pip setuptools wheel numpy

# 4. Compilar OpenCV 4.10
ARG BUILD_OPENCV=1
WORKDIR /tmp
RUN if [ "$BUILD_OPENCV" = "1" ]; then \
        echo "🛠️  Compilando OpenCV (esto puede tardar 4-5 horas)..."; \
        apt-get remove -y python3-opencv || true && \
        rm -rf /usr/lib/python3.6/dist-packages/cv2 && \
        rm -rf /usr/local/lib/python3.6/dist-packages/cv2 && \
        rm -rf /usr/local/lib/python3.11/site-packages/cv2 && \
        git clone --branch 4.10.0 --depth 1 https://github.com/opencv/opencv.git && \
        git clone --branch 4.10.0 --depth 1 https://github.com/opencv/opencv_contrib.git && \
        mkdir -p /tmp/opencv/build && cd /tmp/opencv/build && \
        \
        PY_INCLUDE=$(${PYTHON_BIN} -c "import sysconfig; print(sysconfig.get_path('include'))") && \
        PY_LIB=$(${PYTHON_BIN} -c "import sysconfig; from pathlib import Path; print(str(Path(sysconfig.get_config_var('LIBDIR')) / ('libpython' + sysconfig.get_config_var('LDVERSION') + '.so')))") && \
        PY_NUMPY_INCLUDE=$(${PYTHON_BIN} -c "import numpy; print(numpy.get_include())") && \
        \
        # CONFIGURACIÓN CRÍTICA PARA CUDA 10.2 + OPENCV 4.10:
        # 1. Pasamos -I/opt/libcudacxx/include tanto a CXX como a CUDA_NVCC_FLAGS
        # 2. Forzamos C++17
        cmake -D CMAKE_BUILD_TYPE=Release \
              -D CMAKE_INSTALL_PREFIX=/usr/local \
              -D OPENCV_EXTRA_MODULES_PATH=/tmp/opencv_contrib/modules \
              -D EIGEN_INCLUDE_PATH=/usr/include/eigen3 \
              -D WITH_OPENCL=OFF \
              -D WITH_CUDA=ON \
              -D CUDA_ARCH_BIN="5.3" \
              -D CUDA_ARCH_PTX="" \
              -D WITH_CUDNN=ON \
              -D WITH_CUBLAS=ON \
              -D ENABLE_FAST_MATH=1 \
              -D CUDA_FAST_MATH=1 \
              -D OPENCV_DNN_CUDA=ON \
              -D WITH_OPENGL=ON \
              -D WITH_GTK=ON \
              -D WITH_QT=OFF \
              -D WITH_OPENEXR=OFF \
              -D WITH_CAROTENE=OFF \
              -D OPENCV_ENABLE_NONFREE=ON \
              -D WITH_GSTREAMER=ON \
              -D OPENCV_GENERATE_PKGCONFIG=ON \
              -D OPENCV_SKIP_PYTHON_LOADER=ON \
              -D BUILD_opencv_python2=OFF \
              -D BUILD_opencv_python3=ON \
              -D CUDA_TOOLKIT_ROOT_DIR=/usr/local/cuda \
              -D CMAKE_CUDA_COMPILER=/usr/local/cuda/bin/nvcc \
              -D CMAKE_CXX_STANDARD=17 \
              -D CMAKE_CUDA_STANDARD=17 \
              # AQUÍ ESTÁ EL TRUCO: Forzamos el include en las flags de NVCC directamente
              -D CMAKE_CUDA_FLAGS="--expt-relaxed-constexpr -I/opt/libcudacxx/include" \
              -D OPENCV_EXTRA_CXX_FLAGS="-I/opt/libcudacxx/include" \
              -D PYTHON3_EXECUTABLE=$(which ${PYTHON_BIN}) \
              -D PYTHON3_INCLUDE_DIR=${PY_INCLUDE} \
              -D PYTHON3_LIBRARY=${PY_LIB} \
              -D PYTHON3_NUMPY_INCLUDE_DIRS=${PY_NUMPY_INCLUDE} \
              -D CMAKE_CXX_FLAGS="-pthread" \
              -D CMAKE_EXE_LINKER_FLAGS="-pthread" \
              -D BUILD_EXAMPLES=OFF \
              -D BUILD_TESTS=OFF \
              -D BUILD_PERF_TESTS=OFF \
              -D BUILD_DOCS=OFF \
              -D BUILD_JAVA=OFF \
              .. && \
        cd /tmp/opencv/build && \
        make -j2 && \
        make install && \
        ldconfig && \
        rm -rf /tmp/opencv /tmp/opencv_contrib && \
        echo "✅ OpenCV 4.10 instalado correctamente"; \
    else \
        echo "⏭️  Saltando compilación de OpenCV"; \
    fi

# 5. Dependencias y Modelos del Proyecto
WORKDIR /app
COPY requirements.jetson.txt /app/requirements.txt

RUN ${PYTHON_BIN} -m pip install --no-cache-dir --upgrade pip setuptools wheel && \
    ${PYTHON_BIN} -m pip install --no-cache-dir --ignore-installed PyYAML && \
    cat requirements.txt | grep -v "opencv-python" > requirements_filtered.txt && \
    ${PYTHON_BIN} -m pip install --no-cache-dir -r requirements_filtered.txt && \
    if [ -d /opt/jetson-inference/python/training/classification ]; then \
        cd /opt/jetson-inference/python/training/classification && ./download-models.sh; \
    fi

RUN mkdir -p /app/models && \
    curl -L -o /app/models/face_detection_yunet_2023mar.onnx https://github.com/opencv/opencv_zoo/raw/main/models/face_detection_yunet/face_detection_yunet_2023mar.onnx && \
    curl -L -o /app/models/face_recognition_sface_2021dec.onnx https://github.com/opencv/opencv_zoo/raw/main/models/face_recognition_sface/face_recognition_sface_2021dec.onnx && \
    curl -L -o /app/models/ESPCN_x4.pb https://github.com/Saafke/EDSR_Tensorflow/raw/master/models/ESPCN_x4.pb && \
    curl -L -o /app/models/FSRCNN_x4.pb https://github.com/Saafke/FSRCNN_Tensorflow/raw/master/models/FSRCNN_x4.pb

COPY . /app
RUN mkdir -p /app/ai_engine/models && \
    cp /app/models/* /app/ai_engine/models/

ENV SUPERRES_MODEL_PATH=/app/models/ESPCN_x4.pb

CMD ["uvicorn", "src.inference_api:app", "--host", "0.0.0.0", "--port", "5050", "--workers", "1"]# ==============================================================================
