# ==============================================================================
# Dockerfile Final para Jetson Nano
# Soluciona: Error GPG de Kitware y habilita GPU para OpenCV
# ==============================================================================

# 1. IMAGEN BASE CORRECTA (JetPack 4.6.1)
# Esta versión es obligatoria para que la GPU funcione en tu Nano actual
ARG BASE_IMAGE=nvcr.io/nvidia/l4t-pytorch:r32.7.1-pth1.10-py3
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV SHELL /bin/bash
# Configuración regional para evitar errores de Python
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

WORKDIR /jetson-inference

# 2. INSTALACIÓN UNIFICADA (SISTEMA + OPENCV)
# Aquí ocurre la magia: Hacemos update UNA sola vez con "|| true" para ignorar
# el error del repo Kitware, e instalamos python3-opencv del sistema (con soporte GPU).
RUN rm -f /etc/apt/sources.list.d/kitware* && \
    apt-get update || true && \
    apt-get install -y --no-install-recommends \
            python3-opencv \
            cmake \
            nano \
            wget \
            curl \
            libglib2.0-0 \
            libsm6 \
            libxext6 \
            libxrender-dev \
            gstreamer1.0-tools \
            gstreamer1.0-plugins-good \
            gstreamer1.0-plugins-bad \
            gstreamer1.0-plugins-ugly \
            libgstreamer-plugins-base1.0-dev \
            libgstreamer-plugins-good1.0-dev \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 3. ACTUALIZAR PIP Y HERRAMIENTAS DE PYTHON
RUN pip3 install --no-cache-dir --verbose --upgrade pip setuptools wheel Cython

# 4. INSTALAR DEPENDENCIAS DE TU API
# Copiamos primero el requirements para aprovechar la caché de Docker
COPY requirements.jetson.txt /app/requirements.txt
WORKDIR /app

RUN pip3 install --no-cache-dir -r requirements.txt

# 5. COPIAR CÓDIGO FUENTE
COPY . /app

# 6. LANZAR API
# Usamos host 0.0.0.0 para que sea accesible desde fuera del contenedor
CMD ["uvicorn", "src.inference_api:app", "--host", "0.0.0.0", "--port", "5050", "--workers", "1"]